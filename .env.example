# Google / Gemini
GEMINI_AUTH=vertex                # vertex | apikey
GCP_PROJECT_ID=
GCP_REGION=global
GEMINI_API_KEY=                   # only if GEMINI_AUTH=apikey

# Models (resolve exact IDs with `pnpm check:providers`)
AGENT_MODEL=gemini-3-flash
SUMMARIZER_MODEL=gemini-3-flash-lite
JUDGE_MODEL=gemini-3-pro
THINKING_LEVEL=                   # optional; passed through where supported
TRACE_THINKING=0

# App
DATABASE_URL=postgres://kakeibo:kakeibo@localhost:5433/kakeibo
# Application connection, as a role that does NOT own the tables so row-level
# security applies to it. `pnpm db:up` creates this role locally; fill in the
# value it prints. Empty falls back to DATABASE_URL, which disables the
# backstop — fine for a first run, not for anything public.
APP_DATABASE_URL=
CONTEXT_BUDGET_TOKENS=60000
ALLOW_WRITES=0                    # mcp server write gate
ALLOW_DESTRUCTIVE_RESET=0         # db:reset and evals refuse a non-localhost database without this
PORT=3000

# Auth
# Generate the secret with `openssl rand -base64 32`. It signs session cookies:
# changing it signs everyone out, and sharing one between environments makes a
# preview deployment's cookie valid in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional. Email/password and anonymous sign-in work without them, and the
# sign-in UI hides the Google button while the client id is empty. The redirect
# URI to register is <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cost control. The defaults are derived, not guessed: a cached web turn
# measures at ~$0.0045, so a $20/month ceiling is $0.667/day, about 148 turns.
# The per-IP cap is deliberately higher than the anonymous per-owner quota —
# offices and mobile carriers put many genuine visitors behind one address.
ANON_DAILY_MESSAGE_QUOTA=8
USER_DAILY_MESSAGE_QUOTA=25
IP_DAILY_MESSAGE_QUOTA=20
GLOBAL_DAILY_BUDGET_USD=0.667
# Salts the per-IP key so raw addresses are never stored. Empty is fine locally;
# in production an empty salt makes the stored hashes a rainbow-table lookup of
# the whole IPv4 space.
RATE_LIMIT_SALT=

# Comma-separated emails allowed to reach /admin. Empty means nobody.
ADMIN_EMAILS=

# Turnstile (Plan D), the fourth cost-control layer. Both empty disables the
# check entirely, which is the normal local and CI state — a challenge cannot be
# solved headlessly. Set both in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Exposed to the browser on purpose: a Turnstile site key is public. Same
# value as TURNSTILE_SITE_KEY; empty means the widget never renders.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Vercel sets this on the project and sends it as a bearer token on every cron
# invocation. Empty disables the check, which is fine locally and is not fine in
# production: /api/cron/reap deletes rows.
CRON_SECRET=
